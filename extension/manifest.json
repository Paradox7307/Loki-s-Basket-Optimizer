{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.heureka.cz/*",
    "https://*.heureka.sk/*",
    "https://*.zbozi.cz/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "lib/store.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.heureka.cz/*",
        "https://*.heureka.sk/*",
        "https://*.zbozi.cz/*"
      ],
      "js": [
        "lib/i18n.js",
        "lib/store.js",
        "lib/parser.js",
        "lib/zbozi.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lokis-basket-optimizer@personal",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}